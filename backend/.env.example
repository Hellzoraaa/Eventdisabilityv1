# ==========================================================
# KONFIGURASI ENVIRONMENT BACKEND & LARAGON MYSQL
# Proyek: AL-Qur-an-Disa
# ==========================================================

# Port Server Backend
PORT=3000
NODE_ENV=development

# Konfigurasi Database MySQL Laragon
# Pengaturan standar Laragon: Host 127.0.0.1, Port 3306, User root, Password kosong
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=quran_disabilitas_db
DB_CONNECTION_LIMIT=10

# URL Frontend (CORS jika dipisah)
FRONTEND_URL=http://localhost:5173
